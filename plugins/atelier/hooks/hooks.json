{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/reprise.mjs\"", "timeout": 10 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/garde-du-shell.mjs\"", "timeout": 10 }]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/garde-du-breaker.mjs\"", "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/garde-de-la-reponse.mjs\"", "timeout": 15 },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fin-de-tour.mjs\"",
            "timeout": 300,
            "statusMessage": "Fin de tour : juge du dépôt sur les fichiers écrits…"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fin-de-tour.mjs\"",
            "timeout": 300,
            "statusMessage": "Fin de tour : juge du dépôt sur les fichiers écrits…"
          }
        ]
      }
    ]
  }
}
